{
  "schema_version": "0.2",
  "policy_id": "gpui-app-agent-template-executable-constitution",
  "repository_profile": "template",
  "lanes": {
    "focused": {
      "persistence": "transient",
      "may_change_protected_paths": false,
      "requires_full_task_spec": false,
      "default_outcome": "eligible"
    },
    "full": {
      "persistence": "committed",
      "may_change_protected_paths": false,
      "requires_full_task_spec": true,
      "default_outcome": "eligible"
    },
    "governance": {
      "persistence": "committed",
      "may_change_protected_paths": true,
      "requires_full_task_spec": true,
      "default_outcome": "review_required"
    },
    "bot": {
      "persistence": "transient",
      "may_change_protected_paths": false,
      "requires_full_task_spec": false,
      "default_outcome": "eligible"
    }
  },
  "checks": {
    "registry": [
      "change-spec",
      "scope",
      "protected-paths",
      "policy",
      "agent-contract",
      "source-risks",
      "architecture",
      "rustfmt",
      "clippy",
      "tests-core",
      "tests-gpui",
      "tests-workspace",
      "repository-full-gate",
      "generated-product",
      "commit-messages",
      "executable-constitution-self-tests",
      "windows-smoke"
    ],
    "profiles": {
      "focused": {
        "allowed_lanes": ["focused"],
        "repository_profiles": ["template", "product"],
        "required_checks": ["change-spec", "scope", "protected-paths"]
      },
      "template": {
        "allowed_lanes": ["full"],
        "repository_profiles": ["template"],
        "required_checks": [
          "change-spec",
          "scope",
          "protected-paths",
          "repository-full-gate",
          "generated-product"
        ]
      },
      "product": {
        "allowed_lanes": ["full"],
        "repository_profiles": ["product"],
        "required_checks": ["change-spec", "scope", "protected-paths", "repository-full-gate"]
      },
      "governance": {
        "allowed_lanes": ["governance"],
        "repository_profiles": ["template", "product"],
        "required_checks": [
          "change-spec",
          "scope",
          "protected-paths",
          "policy",
          "executable-constitution-self-tests",
          "repository-full-gate"
        ]
      },
      "bot": {
        "allowed_lanes": ["bot"],
        "repository_profiles": ["template", "product"],
        "required_checks": ["change-spec", "scope", "protected-paths", "repository-full-gate"]
      }
    }
  },
  "protected_paths": [
    {
      "id": "agent-authority",
      "description": "Agent authority, workflow, and change-contract sources.",
      "globs": [
        "AGENTS.md",
        "**/AGENTS.md",
        "docs/change-contract.md",
        "docs/agent-workflow.md",
        "docs/agent-development-standard.md",
        "docs/agent-task-template.md",
        "docs/testing-standard.md",
        "docs/git-commit-policy.md"
      ],
      "allowed_lanes": ["governance"]
    },
    {
      "id": "machine-policy",
      "description": "Machine policy and schemas.",
      "globs": [".agentinfra/policy.json", ".agentinfra/schemas/**"],
      "allowed_lanes": ["governance"]
    },
    {
      "id": "acceptance-controls",
      "description": "Scripts that decide repository or change acceptance.",
      "globs": [
        ".githooks/commit-msg",
        "scripts/lib/ExecutableConstitution.psm1",
        "scripts/check.ps1",
        "scripts/check-agent-contract.ps1",
        "scripts/check-architecture.ps1",
        "scripts/check-change-spec.ps1",
        "scripts/check-commit-message.ps1",
        "scripts/check-commits.ps1",
        "scripts/check-policy.ps1",
        "scripts/check-product.ps1",
        "scripts/check-protected-paths.ps1",
        "scripts/check-scope.ps1",
        "scripts/check-source-risks.ps1",
        "scripts/init-project.ps1",
        "scripts/new-change.ps1",
        "scripts/product-identity.psm1",
        "scripts/resolve-cargo.ps1",
        "scripts/resolve-desktop-target.ps1",
        "scripts/smoke.ps1",
        "scripts/test-executable-constitution.ps1",
        "scripts/test-generated-project.ps1",
        "scripts/test-policy-scripts.ps1",
        "scripts/test-product-identity.ps1",
        "scripts/test.ps1"
      ],
      "allowed_lanes": ["governance"]
    },
    {
      "id": "remote-trust",
      "description": "Hosted CI and future ownership controls.",
      "globs": [".github/workflows/**", ".github/CODEOWNERS"],
      "allowed_lanes": ["governance"]
    },
    {
      "id": "risk-exceptions",
      "description": "Reviewed source-risk exceptions.",
      "globs": ["docs/agent-risk-allowlist.txt"],
      "allowed_lanes": ["governance"]
    }
  ],
  "budget_indicators": {
    "new_crate_manifests": ["crates/*/Cargo.toml"],
    "new_manifests": ["**/Cargo.toml"],
    "dependency_manifest_files": ["Cargo.toml", "Cargo.lock", "crates/*/Cargo.toml"],
    "workflow_files": [".github/workflows/**"]
  },
  "bot": {
    "allowed_paths": ["Cargo.toml", "Cargo.lock", "crates/*/Cargo.toml"],
    "forbidden_paths": [".github/workflows/**", "**/*.rs"]
  },
  "result_statuses": [
    "passed",
    "failed",
    "skipped",
    "not_run",
    "environment_failure",
    "policy_rejected",
    "review_required"
  ],
  "passing_statuses": ["passed"]
}
