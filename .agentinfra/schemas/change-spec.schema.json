{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/gpui-app-agent-template/change-spec.schema.json",
  "title": "Executable Constitution ChangeSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "title",
    "state",
    "lane",
    "change_kind",
    "task_start_revision",
    "intent",
    "scope",
    "budgets",
    "architecture",
    "verification",
    "protected_change",
    "residual_risks",
    "owner_decisions",
    "exclusions"
  ],
  "properties": {
    "schema_version": { "const": "0.2" },
    "change_id": {
      "type": "string",
      "pattern": "^EC-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "state": { "enum": ["draft", "ready"] },
    "lane": { "enum": ["focused", "full", "governance", "bot"] },
    "change_kind": {
      "enum": ["feature", "fix", "dependency", "documentation", "governance"]
    },
    "task_start_revision": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40,64}$"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "recovery"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "recovery": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths", "expected_crates"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_crates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_crates",
        "dependency_manifest_files",
        "new_manifests",
        "new_unsafe_boundaries",
        "protected_files",
        "workflow_files",
        "public_architecture_layers"
      ],
      "properties": {
        "new_crates": { "$ref": "#/definitions/budget" },
        "dependency_manifest_files": { "$ref": "#/definitions/budget" },
        "new_manifests": { "$ref": "#/definitions/budget" },
        "new_unsafe_boundaries": { "$ref": "#/definitions/budget" },
        "protected_files": { "$ref": "#/definitions/budget" },
        "workflow_files": { "$ref": "#/definitions/budget" },
        "public_architecture_layers": { "$ref": "#/definitions/budget" }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changes_owner_or_dependency_direction",
        "changes_async_or_resource_lifecycle",
        "changes_platform_boundary",
        "changes_dependencies",
        "changes_protocol_or_persistence",
        "changes_privacy_or_sensitive_data",
        "changes_unsafe_boundary",
        "changes_public_architecture_layers",
        "adr_paths"
      ],
      "properties": {
        "changes_owner_or_dependency_direction": { "type": "boolean" },
        "changes_async_or_resource_lifecycle": { "type": "boolean" },
        "changes_platform_boundary": { "type": "boolean" },
        "changes_dependencies": { "type": "boolean" },
        "changes_protocol_or_persistence": { "type": "boolean" },
        "changes_privacy_or_sensitive_data": { "type": "boolean" },
        "changes_unsafe_boundary": { "type": "boolean" },
        "changes_public_architecture_layers": { "type": "boolean" },
        "adr_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "required_checks"],
      "properties": {
        "profile": {
          "enum": ["focused", "template", "product", "governance", "bot"]
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "protected_change": { "type": "boolean" },
    "residual_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "owner_decisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "budget": { "type": "integer", "minimum": 0 }
  }
}
